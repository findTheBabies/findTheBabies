{
  "name": "findthebabies",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/build.mjs",
    "test:rules": "node --test tests/rules.test.mjs",
    "test": "firebase emulators:exec --config firebase.emulator-test.json --only firestore,auth,functions --project demo-four-sites \"node --test --test-concurrency=1 tests/rules.test.mjs functions/test/notify.e2e.mjs\"",
    "emulators": "firebase emulators:start --config firebase.emulator-test.json --only firestore,auth,functions --project demo-four-sites",
    "dev:test": "VITE_AUTH_PORT=9199 VITE_FIRESTORE_PORT=8181 vite --mode test --host 127.0.0.1 --port 4174"
  },
  "dependencies": {
    "firebase": "^12.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "vite": "^7.0.0",
    "@firebase/rules-unit-testing": "^5.0.0",
    "@playwright/test": "^1.56.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.13.6"
  }
}
